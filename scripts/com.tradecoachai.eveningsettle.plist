<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradecoachai.eveningsettle</string>

    <!-- v1.9: caffeinate -i -s でスクリプトのプロセス生存期間だけシステムスリープを防止する。
         処理終了と同時にアサーションは自動解放される。判定ロジックには無関係。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>/Users/okashogo/Developer/tradecoach-ai/scripts/run-evening-settle.sh</string>
    </array>

    <!-- 毎日16:30（Macのシステム時刻=日本時間想定）に検証専用処理を実行。
         新しい判定・TOP3・LINE通知は行わない（run-evening-settle.sh参照）。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Version 1.3: ログイン直後・スリープ復帰直後にも、当日未実行かつ安全な時間帯（16:00-23:59）
         であればキャッチアップ実行する。安全窓の判定自体はrun-evening-settle.sh側で行う。 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/okashogo/Developer/tradecoach-ai/logs/launchd-evening-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/okashogo/Developer/tradecoach-ai/logs/launchd-evening-stderr.log</string>
</dict>
</plist>
