<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradecoachai.morningsignal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>/Users/okashogo/Developer/tradecoach-ai/scripts/run-morning-signal.sh</string>
    </array>

    <!-- 毎朝8:30（Macのシステム時刻＝日本時間想定）に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Version 1.3: ログイン直後・スリープ復帰直後にも、当日未実行かつ安全な時間帯（08:30-13:00）
         であればキャッチアップ実行する。夜に起動した場合に鮮度を失ったTOP3通知を送らないよう、
         安全窓の判定はrun-morning-signal.sh側で厳密に行う（単純な「未実行なら即実行」ではない）。 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd自体がスクリプトを起動できなかった場合（実行権限がない等）の低レベルなログ -->
    <key>StandardOutPath</key>
    <string>/Users/okashogo/Developer/tradecoach-ai/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/okashogo/Developer/tradecoach-ai/logs/launchd-stderr.log</string>
</dict>
</plist>
